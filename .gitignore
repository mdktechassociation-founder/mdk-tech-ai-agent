# ------------------------------------------------------------
# Secrets & environment files: NEVER commit these
# (AI agents usually need API keys; keep them in .env)
# ------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# ------------------------------------------------------------
# OS files
# ------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ------------------------------------------------------------
# Editors / IDEs
# ------------------------------------------------------------
.vscode/
.idea/
*.swp
*~

# ------------------------------------------------------------
# Logs & temporary files
# ------------------------------------------------------------
*.log
logs/
tmp/
temp/

# ------------------------------------------------------------
# Common dependency & build folders (harmless if unused;
# covers Python and Node.js for when the stack is chosen)
# ------------------------------------------------------------
node_modules/
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/

# Flutter generated files
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
/build/
/windows/flutter/ephemeral/
/linux/flutter/ephemeral/
/macos/Flutter/ephemeral/
/ios/Flutter/ephemeral/

# Python backend
services/agent_api/.venv/
*.pyc
__pycache__/

# Local secrets and runtime state
services/agent_api/.env
services/agent_api/.env.*
!services/agent_api/.env.example
*.sqlite3
.runtime/
